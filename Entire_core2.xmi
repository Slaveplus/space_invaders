<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://www.omg.org/spec/UML/2.0">
  <uml:Model xmi:id="model-root" name="SpaceInvaders Full Model">

    <packagedElement xmi:type="uml:DataType" xmi:id="type-graphics" name="Graphics"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-graphics2d" name="java.awt.Graphics2D"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-bufferedimage" name="BufferedImage"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-rectangle" name="java.awt.Rectangle"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-keyevent" name="KeyEvent"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-image" name="Image"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-font" name="Font"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-atomiclong" name="java.util.concurrent.atomic.AtomicLong"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-random" name="Random"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-sprite" name="Sprite"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-runnable" name="Runnable"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-keyadapter" name="KeyAdapter"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-mouseadapter" name="MouseAdapter"/>

    <packagedElement xmi:type="uml:DataType" xmi:id="type-list-entity" name="List&lt;Entity&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-arraylist-entity" name="ArrayList&lt;Entity&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-map-string-string" name="Map&lt;String, String&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-map-long-entity" name="Map&lt;Long, Entity&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-map-string-bool" name="Map&lt;String, Boolean&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-map-int-bufferedimage" name="Map&lt;Integer, BufferedImage&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-deque-string" name="Deque&lt;String&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-queue-gameevent" name="Queue&lt;GameEvent&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-collection-string" name="Collection&lt;String&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-list-gamerecord" name="List&lt;GameRecord&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-list-playerinfo" name="List&lt;PlayerInfo&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-list-roominfo" name="List&lt;RoomInfo&gt;"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-set-entity" name="java.util.Set&lt;Entity&gt;"/>

    <packagedElement xmi:type="uml:DataType" xmi:id="type-usermanager" name="UserManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-resolutionmanager" name="ResolutionManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamestatemanager" name="GameStateManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-multyplay-gamestatemanager" name="MultiplayerGameStateManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-skillmanager" name="SkillManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-multyplay-skillmanager" name="MultiplayerSkillManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-uirenderer" name="UIRenderer"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-multyplay-uirenderer" name="MultiplayerUIRenderer"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-backgroundrenderer" name="BackgroundRenderer"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-inputmanager" name="InputManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-multyplay-inputmanager" name="MultiplayerInputManager"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-screennavigator" name="ScreenNavigator"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-entitysnapshot" name="EntitySnapshot"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamesnapshot" name="GameSnapshot"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamesnapshot-phase" name="GameSnapshot.Phase"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamenetworkadapter" name="GameNetworkAdapter"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gameinitinfo" name="GameInitInfo"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamerecord" name="GameRecord"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gameclient" name="GameClient"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gamestatepayload" name="GameStatePayload"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-gameeventpayload" name="GameEventPayload"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-roundtransition" name="RoundTransition"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-roundtransition-type" name="RoundTransition.Type"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-shared-coordinator" name="SharedGameplayCoordinator"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-shared-coordinator-transition" name="SharedMultiplayerRoundCoordinator.TransitionKind"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-skillactionresult" name="SkillActionResult"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-playerinput" name="PlayerInput"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-playerruntime" name="PlayerRuntime"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-playerstate" name="PlayerState"/>
    <packagedElement xmi:type="uml:DataType" xmi:id="type-canvas" name="java.awt.Canvas"/>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg-org" name="org">
      <packagedElement xmi:type="uml:Package" xmi:id="pkg-newdawn" name="newdawn">
        <packagedElement xmi:type="uml:Package" xmi:id="pkg-spaceinvaders" name="spaceinvaders">

          <packagedElement xmi:type="uml:Package" xmi:id="pkg-app" name="app">
            <packagedElement xmi:type="uml:Interface" xmi:id="iface-screen" name="Screen">
              <ownedOperation xmi:id="op-screen-onshow" name="onShow" visibility="package"/>
              <ownedOperation xmi:id="op-screen-onhide" name="onHide" visibility="package"/>
              <ownedOperation xmi:id="op-screen-init" name="init" visibility="package"/>
              <ownedOperation xmi:id="op-screen-update" name="update" visibility="package">
                <ownedParameter name="delta" type="uml:PrimitiveType#Integer" direction="in"/>
              </ownedOperation>
              <ownedOperation xmi:id="op-screen-render" name="render" visibility="package">
                <ownedParameter name="g2d" type="type-graphics2d" direction="in"/>
              </ownedOperation>
            </packagedElement>
          </packagedElement>

          <packagedElement xmi:type="uml:Package" xmi:id="pkg-gameplay" name="gameplay">
            <packagedElement xmi:type="uml:Class" xmi:id="class-game" name="Game">
              <generalization xmi:id="gen-game-canvas" general="type-canvas"/>
              <interfaceRealization xmi:id="ireal-game-screen" client="class-game" supplier="iface-screen" contract="iface-screen"/>
              </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="class-inputmanager" name="InputManager">
              </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="pkg-gameplay-entity" name="entity">
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-entity" name="Entity" isAbstract="true">
                    </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-alien" name="AlienEntity">
                    <generalization xmi:id="gen-gameplay-alien-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-boss" name="BossEntity">
                    <generalization xmi:id="gen-gameplay-boss-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-bossshot" name="BossShotEntity">
                    <generalization xmi:id="gen-gameplay-bossshot-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-coin" name="CoinEntity">
                    <generalization xmi:id="gen-gameplay-coin-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-coindisplay" name="CoinDisplayEntity">
                    <generalization xmi:id="gen-gameplay-coindisplay-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-explosion" name="ExplosionEntity">
                    <generalization xmi:id="gen-gameplay-explosion-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-heateffect" name="HeatEffectEntity">
                    <generalization xmi:id="gen-gameplay-heateffect-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-missile" name="MissileEntity">
                    <generalization xmi:id="gen-gameplay-missile-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-near" name="NearEntity">
                    <generalization xmi:id="gen-gameplay-near-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-ship" name="ShipEntity">
                    <generalization xmi:id="gen-gameplay-ship-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-shot" name="ShotEntity">
                    <generalization xmi:id="gen-gameplay-shot-entity" general="class-gameplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Package" xmi:id="pkg-gameplay-entity-attack" name="entity_attack">
                  <packagedElement xmi:type="uml:Class" xmi:id="class-gameplay-magneticfield" name="MagneticFieldEntity">
                      <generalization xmi:id="gen-gameplay-magnetic-entity" general="class-gameplay-entity"/>
                  </packagedElement>
                </packagedElement>
            </packagedElement>
          </packagedElement>

          <packagedElement xmi:type="uml:Package" xmi:id="pkg-multyplay" name="multyplay">
            <packagedElement xmi:type="uml:Package" xmi:id="pkg-multyplay-core" name="core">
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-canvas" name="MultiplayerGameCanvas">
                    <generalization xmi:id="gen-multycanvas-canvas" general="type-canvas"/>
                    <interfaceRealization xmi:id="ireal-canvas-screen" client="class-multyplay-canvas" supplier="iface-screen" contract="iface-screen"/>
                    <interfaceRealization xmi:id="ireal-canvas-context" client="class-multyplay-canvas" supplier="iface-multyplay-context" contract="iface-multyplay-context"/>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-alien" name="RemoteAlienEntity">
                       <generalization xmi:id="gen-remote-alien" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-boss" name="RemoteBossEntity">
                       <generalization xmi:id="gen-remote-boss" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-bossshot" name="RemoteBossShotEntity">
                       <generalization xmi:id="gen-remote-bossshot" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-explosion" name="RemoteExplosionEntity">
                       <generalization xmi:id="gen-remote-explosion" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-heateffect" name="RemoteHeatEffectEntity">
                       <generalization xmi:id="gen-remote-heateffect" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-shot" name="RemoteShotEntity">
                       <generalization xmi:id="gen-remote-shot" general="class-multyplay-entity"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="nested-remote-sprite" name="RemoteSpriteEntity">
                       <generalization xmi:id="gen-remote-sprite" general="class-multyplay-entity"/>
                    </nestedClassifier>
                </packagedElement>
                <packagedElement xmi:type="uml:Interface" xmi:id="iface-multyplay-context" name="MultiplayerGameContext">
                    </packagedElement>
            </packagedElement>
            <packagedElement xmi:type="uml:Package" xmi:id="pkg-multyplay-entity" name="entity">
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-entity" name="Entity" isAbstract="true">
                     </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-alien" name="AlienEntity">
                    <generalization xmi:id="gen-multyplay-alien-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-boss" name="BossEntity">
                    <generalization xmi:id="gen-multyplay-boss-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-bossshot" name="BossShotEntity">
                    <generalization xmi:id="gen-multyplay-bossshot-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-coindisplay" name="CoinDisplayEntity">
                    <generalization xmi:id="gen-multyplay-coindisplay-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-explosion" name="ExplosionEntity">
                    <generalization xmi:id="gen-multyplay-explosion-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-heateffect" name="HeatEffectEntity">
                    <generalization xmi:id="gen-multyplay-heateffect-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-missile" name="MissileEntity">
                    <generalization xmi:id="gen-multyplay-missile-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-near" name="NearEntity">
                    <generalization xmi:id="gen-multyplay-near-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-ship" name="ShipEntity">
                    <generalization xmi:id="gen-multyplay-ship-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-shot" name="ShotEntity">
                    <generalization xmi:id="gen-multyplay-shot-entity" general="class-multyplay-entity"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Package" xmi:id="pkg-multyplay-entity-attack" name="attack">
                  <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-magneticfield" name="MagneticFieldEntity">
                      <generalization xmi:id="gen-multyplay-magnetic-entity" general="class-multyplay-entity"/>
                  </packagedElement>
                </packagedElement>
            </packagedElement>
             <packagedElement xmi:type="uml:Package" xmi:id="pkg-multyplay-input" name="input">
                <packagedElement xmi:type="uml:Class" xmi:id="class-multyplay-inputmanager" name="MultiplayerInputManager"/>
            </packagedElement>
          </packagedElement>

          <packagedElement xmi:type="uml:Package" xmi:id="pkg-server" name="server">
            <packagedElement xmi:type="uml:Package" xmi:id="pkg-server-game" name="game">
              <packagedElement xmi:type="uml:Class" xmi:id="class-server-game" name="ServerMultiplayerGame">
                <interfaceRealization xmi:id="ireal-server-context" client="class-server-game" supplier="iface-multyplay-context" contract="iface-multyplay-context"/>
              </packagedElement>
            </packagedElement>
          </packagedElement>

          <packagedElement xmi:type="uml:Package" xmi:id="pkg-room" name="room">
              <packagedElement xmi:type="uml:Class" xmi:id="class-room-canvas" name="Canvas"/>
              <packagedElement xmi:type="uml:Interface" xmi:id="iface-gameclientlistener" name="GameClientListener">
                  </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="class-roomlist" name="RoomListCanvas">
                  <generalization xmi:id="gen-roomlist-canvas" general="class-room-canvas"/>
                  <interfaceRealization xmi:id="ireal-roomlist-screen" client="class-roomlist" supplier="iface-screen" contract="iface-screen"/>
                  <interfaceRealization xmi:id="ireal-roomlist-listener" client="class-roomlist" supplier="iface-gameclientlistener" contract="iface-gameclientlistener"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="class-roomlobby" name="RoomLobbyCanvas">
                  <generalization xmi:id="gen-roomlobby-canvas" general="class-room-canvas"/>
                  <interfaceRealization xmi:id="ireal-roomlobby-screen" client="class-roomlobby" supplier="iface-screen" contract="iface-screen"/>
                  <interfaceRealization xmi:id="ireal-roomlobby-listener" client="class-roomlobby" supplier="iface-gameclientlistener" contract="iface-gameclientlistener"/>
              </packagedElement>
          </packagedElement>
        </packagedElement>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>