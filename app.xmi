<?xml version="1.0" encoding="UTF-8"?><XMI xmlns:UML="href://org.omg/UML/1.3" xmi.version="1.1">
    <XMI.header>
        <XMI.documentation>
            <XMI.exporter>PlantUML</XMI.exporter>
            <XMI.exporterVersion>1.2025.8</XMI.exporterVersion>
        </XMI.documentation>
        <XMI.metamodel xmi.name="UML" xmi.version="1.4"/>
    </XMI.header>
    <XMI.content>
        <UML:Model name="PlantUML" xmi.id="model1">
            <UML:Namespace.ownedElement>
                <UML:Class isInterface="true" name="Screen" xmi.id="ent0002">
                    <UML:Classifier.feature>
                        <UML:Operation name="void onShow()" visibility="package" xmi.id="att8"/>
                        <UML:Operation name="void onHide()" visibility="package" xmi.id="att9"/>
                        <UML:Operation name="void init()" visibility="package" xmi.id="att10"/>
                        <UML:Operation name="void update(long)" visibility="package" xmi.id="att11"/>
                        <UML:Operation name="void render(Graphics2D)" visibility="package" xmi.id="att12"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class isInterface="true" name="ScreenNavigator" xmi.id="ent0007">
                    <UML:Classifier.feature>
                        <UML:Operation name="void showLogin()" visibility="package" xmi.id="att13"/>
                        <UML:Operation name="void showMainMenu()" visibility="package" xmi.id="att14"/>
                        <UML:Operation name="void startNewGame()" visibility="package" xmi.id="att15"/>
                        <UML:Operation name="void exitGame()" visibility="package" xmi.id="att16"/>
                        <UML:Operation name="void setResolution(int,int)" visibility="package" xmi.id="att17"/>
                        <UML:Operation name="int getCurrentWidth()" visibility="package" xmi.id="att18"/>
                        <UML:Operation name="int getCurrentHeight()" visibility="package" xmi.id="att19"/>
                        <UML:Operation name="ResolutionManager getResolutionManager()" visibility="package" xmi.id="att20"/>
                        <UML:Operation name="void showRoomList(GameClient)" visibility="package" xmi.id="att21"/>
                        <UML:Operation name="void showRoomLobby(String)" visibility="package" xmi.id="att22"/>
                        <UML:Operation name="void startMultiplayerGame(GameClient,GameInitInfo)" visibility="package" xmi.id="att23"/>
                    </UML:Classifier.feature>
                </UML:Class>
            </UML:Namespace.ownedElement>
        </UML:Model>
    </XMI.content>
</XMI>
