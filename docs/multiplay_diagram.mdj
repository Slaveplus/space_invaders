													],
													"documentation": "게임의 메인 훅. 이 클래스는 디스플레이 관리자와 게임 로직의 중앙 조정자 역할을 합니다.\n디스플레이 관리는 게임의 모든 엔티티들을 순환하며 이동을 요청하고\n적절한 위치에 그리는 루프로 구성됩니다. 내부 클래스의 도움으로\n플레이어가 메인 우주선을 제어할 수 있도록 합니다.\n조정자로서 게임 내 엔티티들이 이벤트를 감지할 때 (예: 적 처치, 플레이어 사망)\n알림을 받고 적절한 게임 액션을 취합니다.\n@author Kevin Glass",
													"attributes": [
														{
															"_type": "UMLAttribute",
															"_id": "AAAAAAGah8BvcU21MHE=",
															"_parent": {
																"$ref": "AAAAAAGah8BsVTv5yHA="
															},
															"name": "ship",
															"documentation": "가속 페이지 플리핑을 사용할 수 있게 해주는 전략\n플레이어를 나타내는 엔티티",
															"visibility": "private"
														},
														{
															"_type": "UMLAttribute",
															"_id": "AAAAAAGah8BvcU22MDQ=",
															"_parent": {
																"$ref": "AAAAAAGah8BsVTv5yHA="
															},
															"name": "moveSpeed",
															"documentation": "플레이어 우주선이 이동해야 하는 속도 (픽셀/초)",
															"visibility": "private",
															"type": "double",
															"defaultValue": "300"
														},
														{
															"_type": "UMLAttribute",
															"_id": "AAAAAAGah8BvcU23BTs=",
															"_parent": {
																"$ref": "AAAAAAGah8BsVTv5yHA="
															},
