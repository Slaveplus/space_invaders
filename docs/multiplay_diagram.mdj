															"_id": "AAAAAAGah8Bswj+XcrQ=",
															"_parent": {
																"$ref": "AAAAAAGah8BslT65AjE="
															},
															"name": "Entity",
															"documentation": "엔티티는 게임에 나타나는 모든 요소를 나타냅니다.\n엔티티는 서브클래스나 외부에서 정의된 속성 세트를 기반으로\n충돌과 이동을 해결하는 책임을 집니다.\n위치에 double을 사용한다는 점에 주목하세요. 픽셀 위치가 정수라는 점을 고려하면\n이상할 수 있습니다. 하지만 double을 사용하면 엔티티가 부분 픽셀을 이동할 수 있습니다.\n물론 픽셀 중간에 표시된다는 의미는 아니지만, 이동할 때 정확도를 잃지 않도록 해줍니다.\n@author Kevin Glass",
															"attributes": [
																{
																	"_type": "UMLAttribute",
																	"_id": "AAAAAAGah8Bvc05gTio=",
																	"_parent": {
																		"$ref": "AAAAAAGah8Bswj+XcrQ="
																	},
																	"name": "ID_GENERATOR",
																	"visibility": "private",
																	"isStatic": true,
																	"isLeaf": true,
																	"isReadOnly": true
																},
																{
																	"_type": "UMLAttribute",
																	"_id": "AAAAAAGah8Bvc05hCXA=",
																	"_parent": {
																		"$ref": "AAAAAAGah8Bswj+XcrQ="
																	},
																	"name": "entityId",
																	"documentation": "전역 유니크 엔티티 ID (동기화/직렬화 용)",
																	"visibility": "private",
																	"isLeaf": true,
																	"type": "long",
																	"isReadOnly": true
																},
