														{
															"_type": "UMLClass",
															"_id": "AAAAAAGah8BuXkbujM4=",
															"_parent": {
																"$ref": "AAAAAAGah8BuO0YeWUs="
															},
															"name": "Entity",
															"documentation": "엔티티는 게임에 나타나는 모든 요소를 나타냅니다.\n엔티티는 서브클래스나 외부에서 정의된 속성 집합을 기반으로\n충돌과 이동을 처리합니다.\n위치에 double을 사용한다는 점에 주의하세요. 픽셀 위치가 정수라는 점을 고려하면\n이상하게 보일 수 있지만, double을 사용하면 엔티티가 부분 픽셀을 이동할 수 있습니다.\n물론 픽셀의 절반 위치에 표시되는 것은 아니지만, 이동 시 정확도를 잃지 않을 수 있습니다.\n@author Kevin Glass",
															"attributes": [
																{
																	"_type": "UMLAttribute",
																	"_id": "AAAAAAGah8Bvd1A4HoQ=",
																	"_parent": {
																		"$ref": "AAAAAAGah8BuXkbujM4="
																	},
																	"name": "ID_GENERATOR",
																	"visibility": "private",
																	"isStatic": true,
																	"isLeaf": true,
																	"isReadOnly": true
																},
																{
																	"_type": "UMLAttribute",
																	"_id": "AAAAAAGah8Bvd1A566E=",
																	"_parent": {
																		"$ref": "AAAAAAGah8BuXkbujM4="
